---
import Base from '../layouts/Base.astro';
import { projects, contributions } from '../data/profile';

const patchCount = contributions.reduce((n, c) => n + c.items.length, 0);
---

<Base
  title="Open Source"
  description="Projects I lead and maintain, and patches I've landed upstream."
>
  <h1 class="page-title">Open Source</h1>
  <p class="page-lede">
    {projects.length} projects I lead or maintain, and {patchCount} patches landed
    across {contributions.length} upstream repositories.
  </p>

  <section class="section">
    <h2>Maintaining</h2>
    <ul class="projects">
      {projects.map((p) => (
        <li>
          <div class="proj-head">
            <a class="proj-name" href={p.href} target="_blank" rel="noopener">{p.name}</a>
            <span class="proj-role">{p.role}</span>
            <span class="proj-period">{p.period}</span>
          </div>
          <p class="proj-desc">{p.description}</p>
          {p.tags && (
            <div class="tag-row">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2>Upstream Contributions</h2>
    <div class="contribs">
      {contributions.map((c) => (
        <section class="contrib">
          <h3>
            <a href={c.href} target="_blank" rel="noopener">{c.project}</a>
          </h3>
          <p class="contrib-blurb">{c.blurb}</p>
          <ul>
            {c.items.map((item) => (
              <li>
                <span class="ref">{item.ref}</span>
                <a href={item.href} target="_blank" rel="noopener">{item.title}</a>
                <time>{item.date}</time>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .page-title {
    font-family: var(--font-serif);
    font-size: var(--fs-h1);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tight);
    color: var(--text-strong);
    margin: 0 0 var(--sp-3);
  }
  .page-lede {
    max-width: var(--w-prose);
    color: var(--text-muted);
    font-size: var(--fs-base);
    margin: 0 0 var(--sp-6);
  }

  /* ---------- 项目 ---------- */
  .projects { list-style: none; margin: 0; padding: 0; max-width: var(--w-prose); }
  .projects > li {
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--border);
  }
  .projects > li:last-child { border-bottom: 0; }
  .proj-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    margin-bottom: var(--sp-2);
  }
  .proj-name {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    color: var(--text-strong);
  }
  .proj-name:hover { color: var(--accent-hover); }
  .proj-role {
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--text-faint);
    background: var(--accent-wash);
    border-radius: var(--radius-sm);
    padding: 0 var(--sp-2);
  }
  .proj-period {
    font-size: var(--fs-sm);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }
  .proj-desc {
    font-family: var(--font-serif);
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    margin: 0 0 var(--sp-3);
  }

  /* ---------- 上游贡献 ---------- */
  .contribs {
    display: grid;
    gap: var(--sp-6);
    max-width: var(--w-prose);
  }
  .contrib h3 {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    margin: 0 0 var(--sp-1);
  }
  .contrib h3 a { color: var(--text-strong); }
  .contrib h3 a:hover { color: var(--accent-hover); }
  .contrib-blurb {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin: 0 0 var(--sp-3);
  }
  .contrib ul { list-style: none; margin: 0; padding: 0; }
  .contrib li {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    gap: var(--sp-3);
    align-items: baseline;
    padding: var(--sp-2) 0;
    border-top: 1px solid var(--border);
    font-size: var(--fs-sm);
  }
  .contrib .ref {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-faint);
    white-space: nowrap;
  }
  .contrib li a { color: var(--text); line-height: var(--lh-snug); }
  .contrib li a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contrib time {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .contrib li { grid-template-columns: 1fr; gap: var(--sp-1); }
    .contrib time { grid-row: 1; justify-self: start; }
    .proj-period { margin-left: 0; }
  }
</style>
