---
import { site, nav } from '../config';
import {
  getLangFromUrl,
  pick,
  localizePath,
  stripLangPrefix,
  LANGS,
  LANG_NAMES,
} from '../i18n';
import { useTranslations, type UIKey } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const path = Astro.url.pathname;
/** 语言无关的当前路径，用来判断导航高亮和算另一语言的链接 */
const bare = stripLangPrefix(path);

function isCurrent(href: string) {
  if (href === '/') return bare === '/';
  return bare === href || bare.startsWith(href);
}

/** 另一个语言版本的同一页 */
const otherLang = LANGS.find((l) => l !== lang)!;
const otherHref = localizePath(bare, otherLang);
---

<header class="site-header">
  <div>
    <a class="wordmark" href={localizePath('/', lang)}>{site.title}</a>
    <div class="site-tagline">{pick(site.subtitle, lang)}</div>
  </div>

  <nav class="site-nav" aria-label={t('a11y.mainNav')}>
    {nav.map((item) => (
      <a
        href={item.external ? localizePath(item.href, lang) : localizePath(item.href, lang)}
        aria-current={!item.external && isCurrent(item.href) ? 'page' : undefined}
      >
        {t(item.labelKey as UIKey)}
      </a>
    ))}

    {/* 语言切换：只有两种语言，用直接跳转比下拉菜单省事 */}
    <a class="lang-switch" href={otherHref} lang={otherLang} title={t('a11y.switchLang')}>
      {LANG_NAMES[otherLang]}
    </a>

    <button class="theme-toggle" type="button" aria-label={t('a11y.toggleTheme')} title={t('a11y.toggleTheme')}>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
      </svg>
    </button>
  </nav>
</header>

<style>
  .lang-switch {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1px var(--sp-2);
    font-size: var(--fs-sm);
  }
  .lang-switch:hover { border-color: var(--border-strong); }
</style>

<script>
  // 点击切换 light/dark，并记住选择。
  // 没点过的用户不写 localStorage，始终跟随系统。
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root = document.documentElement;

  function currentTheme(): 'light' | 'dark' {
    const attr = root.getAttribute('data-theme');
    if (attr === 'light' || attr === 'dark') return attr;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  btn?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* 隐私模式，切换只在本次会话生效 */
    }
  });
</script>
