---
/**
 * 首页正文顶上的一条生命游戏横幅。
 *
 * favicon 里那个 16×16 太隐蔽了（谁会盯着标签页看），所以这里放一条
 * 铺满正文宽度的。对比度压得比较低 —— 是会呼吸的页眉，不是要抢戏的图。
 *
 * 点 reseed 重新播种。
 */
---

<div class="life">
  <canvas id="life-canvas" aria-hidden="true"></canvas>
  <button class="life-reseed" type="button" aria-label="Reseed the Game of Life">life</button>
</div>

<script>
  import { makeGrid, seedWithPatterns, step, StallDetector, type Grid } from '@/lib/life';

  const CELL = 6;        // 每格 6 CSS px
  const INTERVAL = 320;  // 每代间隔

  const canvas = document.getElementById('life-canvas') as HTMLCanvasElement | null;
  const btn = document.querySelector<HTMLButtonElement>('.life-reseed');
  if (canvas) run(canvas);

  function run(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let grid: Grid;
    const stall = new StallDetector();
    let timer: number | undefined;

    function fit() {
      const dpr = window.devicePixelRatio || 1;
      const cssW = canvas.clientWidth || 240;
      const cssH = 132;   // 高一点，绝对活细胞数才够看
      canvas.width = Math.round(cssW * dpr);
      canvas.height = Math.round(cssH * dpr);
      canvas.style.height = cssH + 'px';
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const w = Math.max(8, Math.floor(cssW / CELL));
      const h = Math.max(6, Math.floor(cssH / CELL));
      // 摆已知图样 + 少量背景噪点。纯随机出来就是一片没意义的雪花。
      grid = seedWithPatterns(makeGrid(w, h));
      stall.reset();
      draw();
    }

    function draw() {
      const cs = getComputedStyle(document.documentElement);
      const fg = cs.getPropertyValue('--link').trim() || '#9F8383';
      ctx!.clearRect(0, 0, canvas.width, canvas.height);
      ctx!.fillStyle = fg;
      for (let i = 0; i < grid.cells.length; i++) {
        if (!grid.cells[i]) continue;
        const x = (i % grid.w) * CELL;
        const y = Math.floor(i / grid.w) * CELL;
        ctx!.fillRect(x, y, CELL - 1, CELL - 1);
      }
    }

    /**
     * Conway 规则下随机汤最终会稳定在 ~3% 存活率，也就是越跑越空。
     * 想让它一直好看，就得有个种群下限：低于阈值补种。
     * 补种不是清空重来 —— 在现有局面上再撒一批图样，看着是连续演化。
     */
    const FLOOR = 0.055;  // 活细胞占比低于这个就补种

    function population(): number {
      let n = 0;
      for (let i = 0; i < grid.cells.length; i++) n += grid.cells[i];
      return n / grid.cells.length;
    }

    function tick() {
      grid = step(grid);

      if (stall.check(grid)) {
        grid = seedWithPatterns(makeGrid(grid.w, grid.h));
      } else if (population() < FLOOR) {
        // 在活着的局面上追加图样，保留已有结构
        const fresh = seedWithPatterns(makeGrid(grid.w, grid.h), { noise: 0.16 });
        for (let i = 0; i < grid.cells.length; i++) {
          grid.cells[i] = grid.cells[i] | fresh.cells[i];
        }
        stall.reset();
      }

      draw();
    }

    const play = () => { if (timer === undefined) timer = window.setInterval(tick, INTERVAL); };
    const pause = () => { if (timer !== undefined) { clearInterval(timer); timer = undefined; } };

    fit();
    // 只在标签页可见时跑，别空转耗电
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
    // 主题切换要立刻重画，不然颜色对不上
    new MutationObserver(draw).observe(document.documentElement, {
      attributes: true, attributeFilter: ['data-theme'],
    });
    window.addEventListener('resize', fit);
    btn?.addEventListener('click', fit);

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) play();
  }
</script>

<style>
  .life {
    position: relative;
    /* 和下面各分节的标题横线同宽（铺满正文列），
       不要用 --w-prose —— 那是正文行宽，两者对不齐会很难看 */
    margin: 0 0 var(--sp-6);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--border);
  }
  .life canvas {
    display: block;
    width: 100%;
    /* 压低一些：是会呼吸的页眉，不是插图 */
    opacity: 0.7;
  }
  .life-reseed {
    position: absolute;
    right: 0;
    bottom: var(--sp-3);
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-faint);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  /* 平时藏起来，鼠标移上去才出现，不打扰阅读 */
  .life:hover .life-reseed,
  .life-reseed:focus-visible { opacity: 1; }
  .life-reseed:hover { color: var(--link); }
  .life-reseed::before { content: '↻ '; }
</style>
