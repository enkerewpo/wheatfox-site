---
import { postUrl, formatDate, type Post } from '@/lib/posts';

interface Props {
  posts: Post[];
  /** 'long' = 2026-01-13，'short' = 01-13（按年分组时用短的） */
  dateStyle?: 'long' | 'short';
}

const { posts, dateStyle = 'long' } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => (
    <li class="post-item">
      <time datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date, dateStyle)}
      </time>
      {/*
        文章正文多为中文，lang 属性让浏览器用对断行规则和字体回落。
        featured 的加粗样式在 base.css 里。
      */}
      <a
        class:list={['post-link', { featured: post.data.featured }]}
        href={postUrl(post)}
        lang={post.data.lang}
      >
        {post.data.title}
      </a>
    </li>
  ))}
</ul>
