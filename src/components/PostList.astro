---
import { postUrl, formatDate, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** 'long' = 2026-01-13，'short' = 01-13（归档页按年分组时用短的） */
  dateStyle?: 'long' | 'short';
}

const { posts, dateStyle = 'long' } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => (
    <li class="post-item">
      <time datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date, dateStyle)}
      </time>
      <a class="post-link" href={postUrl(post)}>{post.data.title}</a>
    </li>
  ))}
</ul>
