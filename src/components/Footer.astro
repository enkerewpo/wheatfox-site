---
import { site, beian, footerCredits, analytics } from '@/config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  {analytics.busuanzi && (
    <div class="footer-row" id="busuanzi-stats" hidden>
      <span id="busuanzi_container_site_pv">
        Visits <span id="busuanzi_value_site_pv"></span>
      </span>
      <span class="sep">·</span>
      <span id="busuanzi_container_site_uv">
        Visitors <span id="busuanzi_value_site_uv"></span>
      </span>
    </div>
  )}

  {footerCredits.length > 0 && (
    <div class="footer-row">
      Hosted with thanks to 
      {footerCredits.map((c, i) => (
        <>
          {i > 0 && (i === footerCredits.length - 1 ? ' and ' : ', ')}
          <a href={c.href} target="_blank" rel="noopener">{c.icon && (
            <span class="credit-icon" aria-hidden="true" style={`background-image:url(${c.icon})`}></span>
          )}{c.label}</a>
        </>
      ))}
    </div>
  )}

  <div class="footer-row">© {year} {site.author}</div>

  {(beian.icp || beian.police) && (
    <div class="footer-beian">
      {beian.icp && <a href={beian.icpUrl} target="_blank" rel="noopener">{beian.icp}</a>}
      {beian.police && <a href={beian.policeUrl} target="_blank" rel="noopener">{beian.police}</a>}
    </div>
  )}
</footer>

{analytics.busuanzi && (
  <script is:inline async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
)}

{analytics.busuanzi && (
  <script is:inline>
    // 统计脚本是第三方且经常挂，拿到数才显示这一行，
    // 免得页脚常年挂着两个空占位符
    (function () {
      var tries = 0;
      var timer = setInterval(function () {
        var pv = document.getElementById('busuanzi_value_site_pv');
        if (pv && pv.textContent && pv.textContent.trim() !== '') {
          var row = document.getElementById('busuanzi-stats');
          if (row) row.hidden = false;
          clearInterval(timer);
        } else if (++tries > 20) {
          clearInterval(timer);
        }
      }, 250);
    })();
  </script>
)}

<style>
  .site-footer .sep {
    margin: 0 var(--sp-2);
    color: var(--border-strong);
  }

  /* 鸣谢里的吉祥物（Anubis 那只）。
     
     用背景图而不是 <img>，为的是**只露出脑袋**：原图是 512×512 的全身像，
     缩到一行文字的高度时整个人只有几像素，看不出是什么。背景定位裁到
     头部那一块（约占原图 55%），放大后就是一个清楚的大头。

     另外这里不能用 inline-flex —— 之前 .credit 是 inline-flex，它会自成一个
     行盒，于是「and」和「Anubis」落在不同的基线上，看着像换了行。
     纯 inline-block + vertical-align 才跟着文字走。 */
  .footer-row:has(.credit-icon) { line-height: 2; }
  .credit-icon {
    display: inline-block;
    width: 1.5em;
    height: 1.5em;
    margin-right: 0.3em;
    /* 图标比一行文字高，行高不放开的话它会顶出行框、和上下两行叠在一起 */
    vertical-align: -0.45em;
    background-repeat: no-repeat;
    /* 放大到 180%，把视口对准头部 */
    /* 框住「帽子 + 耳朵 + 脸」。原图里这一块大约在 x 12–74%、y 6–66%，
       所以放大到 168%、视口往上提。
       不做圆形裁切：那对狼耳是这个吉祥物最好认的地方，圆角正好把它削掉。 */
    background-size: 168%;
    background-position: 43% 14%;
  }
</style>