---
/**
 * 博客索引。
 * 46 篇这个量级不分页 —— 研究了 9 个技术博客，样本里所有分页的站
 * （regehr/WordPress、lilianweng/PaperMod）都是继承了 CMS 默认值；
 * danluu 一页塞 198 条只有 22KB，Russ Cox 126 条也是一页。
 * 一页全列出，Ctrl+F 就能找。超过 200 篇再说。
 */
import Base from '@/layouts/Base.astro';
import { url } from '@/lib/url';
import PostList from '@/components/PostList.astro';
import { getPosts, groupByYear } from '@/lib/posts';


const posts = await getPosts();
const years = groupByYear(posts);
---

<Base title="Blog" description="Notes on operating systems, hypervisors, Rust, and whatever else I'm reading.">
  <h1 class="page-title">Blog</h1>
  <p class="page-lede">
    Notes on operating systems, hypervisors, Rust, and whatever else I'm reading.
    <br />
    {posts.length} posts across {years.length} years.
    <a href={url("/tags/")}>Browse by tag</a> or <a href={url("/rss.xml")}>subscribe</a>.
  </p>

  {years.map(({ year, posts }) => (
    <section class="year">
      <h2>{year}<span class="year-count">{posts.length}</span></h2>
      <PostList posts={posts} dateStyle="short" />
    </section>
  ))}
</Base>

<style>
  .page-title {
    font-family: var(--font-sans);
    font-size: var(--fs-h1);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tight);
    color: var(--text);
    margin: 0 0 var(--sp-3);
  }
  .page-lede {
    max-width: var(--w-prose);
    color: var(--text-muted);
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    margin: 0 0 var(--sp-7);
  }

  .year { margin-bottom: var(--sp-7); }
  .year h2 {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    color: var(--text);
    margin: 0 0 var(--sp-3);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--border);
  }
  .year-count {
    font-size: var(--fs-xs);
    color: var(--text-faint);
    font-family: var(--font-sans);
  }
</style>
