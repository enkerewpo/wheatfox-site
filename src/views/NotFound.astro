---
import Base from '@/layouts/Base.astro';
import { url } from '@/lib/url';

---

<Base title="404" description="This page does not exist.">
  <div class="notfound">
    <p class="code">404</p>
    <h1>This page doesn't exist.</h1>
    <p>
      It may have moved, or the link may be wrong. Try the
      <a href={url("/blog/")}>archive</a> or head <a href={url("/")}>home</a>.
    </p>
  </div>
</Base>

<style>
  .notfound { max-width: var(--w-prose); padding: var(--sp-8) 0; }
  .code {
    font-family: var(--font-mono); font-size: var(--fs-sm);
    color: var(--text-faint); letter-spacing: 0;
    margin: 0 0 var(--sp-3);
  }
  .notfound h1 {
    font-family: var(--font-sans); font-size: var(--fs-h1);
    font-weight: var(--fw-semibold); letter-spacing: var(--ls-tight);
    color: var(--text); margin: 0 0 var(--sp-4);
  }
  .notfound p:last-child {
    color: var(--text-muted); font-family: var(--font-sans); font-size: var(--fs-prose);
  }
</style>
