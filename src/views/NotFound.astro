---
import Base from '../layouts/Base.astro';
import { getLangFromUrl, localizePath } from '../i18n';
import { useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Base title="404" description={t('404.title')}>
  <div class="notfound">
    <p class="code">404</p>
    <h1>{t('404.title')}</h1>
    <p>
      {t('404.body')}{' '}
      {t('404.tryThe')} <a href={localizePath('/blog/', lang)}>{t('404.archive')}</a>{' '}
      {t('404.orHead')} <a href={localizePath('/', lang)}>{t('404.home')}</a>{lang === 'zh' ? '。' : '.'}
    </p>
  </div>
</Base>

<style>
  .notfound { max-width: var(--w-prose); padding: var(--sp-8) 0; }
  .code {
    font-family: var(--font-mono); font-size: var(--fs-sm);
    color: var(--text-faint); letter-spacing: var(--ls-wide);
    margin: 0 0 var(--sp-3);
  }
  .notfound h1 {
    font-family: var(--font-serif); font-size: var(--fs-h1);
    font-weight: var(--fw-semibold); letter-spacing: var(--ls-tight);
    color: var(--text-strong); margin: 0 0 var(--sp-4);
  }
  .notfound p:last-child {
    color: var(--text-muted); font-family: var(--font-serif); font-size: var(--fs-prose);
  }
</style>
