---
import Base from '@/layouts/Base.astro';
import PostList from '@/components/PostList.astro';
import type { Post } from '@/lib/posts';
import { url } from '@/lib/url';

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;

const count = `${posts.length} post${posts.length === 1 ? '' : 's'}`;
---

<Base title={`Tag: ${tag}`} description={`${count} tagged “${tag}”.`}>
  <p class="crumb"><a href={url("/tags/")}>← All tags</a></p>
  <h1 class="page-title">{tag}</h1>
  <p class="page-lede">{count}</p>

  <PostList posts={posts} />
</Base>

<style>
  .crumb { font-size: var(--fs-sm); margin: 0 0 var(--sp-4); }
  .crumb a { color: var(--text-muted); }
  .crumb a:hover { color: var(--link-hover); }

  .page-title {
    font-family: var(--font-sans);
    font-size: var(--fs-h1);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tight);
    color: var(--text);
    margin: 0 0 var(--sp-2);
    overflow-wrap: break-word;
  }
  .page-lede { color: var(--text-muted); font-size: var(--fs-sm); margin: 0 0 var(--sp-6); }
</style>
