---
/**
 * 首页 = 学术主页，不另开 /about。
 *
 * 这是学术站的压倒性惯例：al-folio 的首页直接渲染 _pages/about.md，
 * Emery Berger 首页的 <h1> 就是 "About"，Matt Might 的 About 是指回
 * 首页的锚点。落地页先给身份和 bio，博客是导航里的次级入口。
 *
 * 区块顺序按博士生站的惯例排（Zhuohan Li、Lianmin Zheng）：
 * Projects 在 Publications 之前 —— 早期研究者的分量在代码里，
 * 不在还没攒够的论文列表里。
 */
import Base from '@/layouts/Base.astro';
import { url } from '@/lib/url';
import Publication from '@/components/Publication.astro';
import LifePanel from '@/components/LifePanel.astro';
import { pagination } from '@/config';
import { getPosts, postUrl, formatDate } from '@/lib/posts';
import {
  profile,
  news,
  NEWS_ON_HOME,
  socials,
  education,
  publications,
  projects,
} from '@/data/profile';


const posts = await getPosts();
const recentPosts = posts.slice(0, pagination.homeRecentPosts);

const newsShown = news.slice(0, NEWS_ON_HOME);
const newsRest = news.slice(NEWS_ON_HOME);

const bio = profile.bio;
const description = bio[0].replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
---

<Base description={description}>
  {/* ---------- 生命游戏横幅 ---------- */}
  <LifePanel />

  {/* ---------- Bio ---------- */}
  <section class="bio prose">
    {bio.map((para) => <p set:html={para} />)}
  </section>

  {/* ---------- 研究方向 ---------- */}
  <section class="section">
    <h2>Research Interests</h2>
    <div class="tag-row">
      {profile.interests.map((i) => <span class="tag">{i}</span>)}
    </div>
  </section>

  {/* ---------- News ---------- */}
  <section class="section">
    <h2>News</h2>
    <ul class="news">
      {newsShown.map((item, i) => (
        /*
          最新一条：前面挂一个单色礼花图标并加粗。
          图标直接内联 SVG 而不是 CSS mask —— mask 要跨文件解析自定义属性，
          出问题很难查，内联的话在 HTML 里就能看见它到底渲没渲染。
          currentColor 保证它跟着文字颜色走，永远是单色。
        */
        <li class:list={{ 'is-latest': i === 0 }}>
          <time>{item.date}</time>
          <span>
            {i === 0 && (
              <svg class="news-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M2.2 21.8 8 8.4l7.6 7.6L2.2 21.8Zm3.3-3.3 6.3-2.6-3.7-3.7-2.6 6.3Z" />
                <path d="M14.5 2.1a1 1 0 0 1 1.3.5c.5 1.1.4 2.3-.1 3.2a1 1 0 1 1-1.7-1c.2-.4.3-1 .1-1.5a1 1 0 0 1 .4-1.2Z" />
                <path d="M18.8 6a1 1 0 0 1 1.2-.7c1.2.3 2.1 1.1 2.6 2a1 1 0 1 1-1.8.9c-.3-.5-.7-.9-1.3-1a1 1 0 0 1-.7-1.2Z" />
                <circle cx="19.1" cy="12.4" r="1.2" />
                <circle cx="12.4" cy="3.1" r="1.1" />
                <circle cx="22" cy="17.1" r="1" />
              </svg>
            )}
            <span set:html={item.text} />
          </span>
        </li>
      ))}
    </ul>
    {newsRest.length > 0 && (
      <details class="news-more">
        <summary>{newsRest.length} earlier</summary>
        <ul class="news">
          {newsRest.map((item) => (
            <li>
              <time>{item.date}</time>
              <span set:html={item.text} />
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>

  {/* ---------- 项目 ---------- */}
  <section class="section">
    <h2>Projects</h2>
    <ul class="projects">
      {projects.map((p) => (
        <li>
          <div class="proj-head">
            <a class="proj-name" href={p.href} target="_blank" rel="noopener">{p.name}</a>
            <span class="proj-role">{p.role}</span>
            <span class="proj-period">{p.period}</span>
          </div>
          <p class="proj-desc">{p.description}</p>
          {p.tags && (
            <div class="tag-row">
              {p.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          )}
        </li>
      ))}
    </ul>
    <p class="more">
      <a href={url("/open-source/")}>Upstream contributions →</a>
    </p>
  </section>

  {/* ---------- 论文 ---------- */}
  <section class="section">
    <h2>Publications</h2>
    <ol class="pub-list">
      {publications.map((pub, i) => (
        <Publication pub={pub} index={publications.length - i} />
      ))}
    </ol>
    <p class="more"><a href={url("/publications/")}>All publications →</a></p>
  </section>

  {/* ---------- 近期文章 ---------- */}
  <section class="section">
    <h2>Recent Writing</h2>
    <ul class="post-list">
      {recentPosts.map((post) => (
        <li class="post-item">
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          <a class="post-link" href={postUrl(post)} lang={post.data.lang}>
            {post.data.title}
          </a>
        </li>
      ))}
    </ul>
    <p class="more">
      <a href={url("/blog/")}>All {posts.length} posts →</a>
    </p>
  </section>

  {/* ---------- 教育 ---------- */}
  <section class="section">
    <h2>Education</h2>
    <ul class="education">
      {education.map((e) => (
        <li>
          <time>{e.period}</time>
          <div>
            <p class="edu-degree">{e.degree} in {e.field}</p>
            <p class="edu-school">
              {e.institutionUrl
                ? <a href={e.institutionUrl} target="_blank" rel="noopener">{e.institution}</a>
                : e.institution}
            </p>
            {e.note && <p class="edu-note">{e.note}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  {/* ---------- 其它链接 ---------- */}
  <section class="section">
    <h2>Elsewhere</h2>
    <ul class="idlinks">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener">
            {s.label}{s.text && <span class="idtext">{s.text}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
    /* ---------- bio ---------- */
  /* 只有四段，铺满正文列即可 —— 46rem 那个行宽是给长文阅读用的，
     首页这段短介绍收窄反而和下面的分节线对不齐 */
  .bio { max-width: none; margin-bottom: var(--sp-7); }
  .bio p:last-child { margin-bottom: 0; }

  /* ---------- news ---------- */
  .news {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--w-prose);
  }
  .news li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--sp-3);
    padding: var(--sp-2) 0;
    font-size: var(--fs-base);
    line-height: var(--lh-base);
  }
  .news time {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* 最新一条：图标在最前，文本加粗、用最强的文字色 */
  .news li.is-latest {
    font-weight: var(--fw-bold);
    color: var(--text);
  }
  .news li.is-latest a { font-weight: var(--fw-bold); }
  .news-icon {
    display: inline-block;
    width: 1.05em;
    height: 1.05em;
    margin-right: 0.42em;
    vertical-align: -0.16em;
    color: var(--link);
  }

  .news-more { margin-top: var(--sp-3); }
  .news-more summary {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    cursor: pointer;
  }
  .news-more summary:hover { color: var(--link-hover); }

  @media (max-width: 34rem) {
    .news li { grid-template-columns: 1fr; gap: var(--sp-1); }
  }

  /* ---------- 论文 ---------- */
  .pub-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--w-prose);
  }

  /* ---------- 项目 ---------- */
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--w-prose);
  }
  .projects > li {
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--border);
  }
  .projects > li:last-child { border-bottom: 0; }
  .proj-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    margin-bottom: var(--sp-2);
  }
  .proj-name {
    font-family: var(--font-sans);
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    color: var(--text);
  }
  .proj-name:hover { color: var(--link-hover); }
  /* 角色用纯文本，不做带底色的角标 */
  .proj-role {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .proj-role::before { content: '— '; color: var(--text-faint); }
  .proj-period {
    font-size: var(--fs-sm);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }
  .proj-desc {
    font-family: var(--font-sans);
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    color: var(--text);
    margin: 0 0 var(--sp-3);
  }

  /* ---------- 教育 ---------- */
  .education {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--w-prose);
  }
  .education li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--sp-3);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--border);
  }
  .education li:last-child { border-bottom: 0; }
  .education time {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .education p { margin: 0; }
  .edu-degree {
    font-family: var(--font-sans);
    font-size: var(--fs-prose);
    color: var(--text);
  }
  .edu-school { font-size: var(--fs-base); color: var(--text-muted); }
  .edu-note {
    font-size: var(--fs-sm);
    color: var(--text-faint);
    margin-top: var(--sp-1) !important;
    font-style: italic;
  }

  @media (max-width: 34rem) {
    .education li { grid-template-columns: 1fr; gap: var(--sp-1); }
    .proj-period { margin-left: 0; }
  }

  /* ---------- Elsewhere 链接行 ---------- */
  .idlinks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    font-size: var(--fs-base);
  }
  .idlinks a { color: var(--link); }
  .idlinks a:hover { color: var(--link-hover); text-decoration: underline; }
  .idlinks .idtext { color: var(--text-faint); margin-left: var(--sp-2); }

  /* ---------- 「查看全部」 ---------- */
  .more { margin: var(--sp-4) 0 0; font-size: var(--fs-sm); }
  .more a { color: var(--text-muted); }
  .more a:hover { color: var(--link-hover); }
</style>
