---
import Base from '@/layouts/Base.astro';
import { url } from '@/lib/url';
import { getTags, tagSlug } from '@/lib/posts';

const tags = await getTags();
---

<Base title="Tags" description={`${tags.length} tags across the archive.`}>
  <h1 class="page-title">Tags</h1>
  <p class="page-lede">{tags.length} tags across the archive.</p>

  <ul class="tag-cloud">
    {tags.map(({ tag, count }) => (
      <li>
        <a href={url(`/tags/${tagSlug(tag)}/`)}>
          {tag}<span class="count">{count}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .page-title {
    font-family: var(--font-sans);
    font-size: var(--fs-h1);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tight);
    color: var(--text);
    margin: 0 0 var(--sp-2);
  }
  .page-lede {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    margin: 0 0 var(--sp-6);
  }

  .tag-cloud {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .tag-cloud a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--sp-1) var(--sp-3);
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .tag-cloud a:hover { color: var(--link-hover); border-color: var(--link); }
  .tag-cloud .count {
    font-size: var(--fs-xs);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
</style>
