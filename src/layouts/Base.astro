---
import { site, images } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// 自托管字体，不走任何第三方 CDN
import '@fontsource/patrick-hand/400.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/prose.css';

interface Props {
  title?: string;
  description?: string;
  /** OG type，文章页传 'article' */
  ogType?: 'website' | 'article';
  /** 文章页传发布时间，用于 OG 和 JSON-LD */
  publishedAt?: Date;
  /** 覆盖默认 OG 图 */
  ogImage?: string;
  /** 是否在正文区外自己控制宽度 */
  wide?: boolean;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  publishedAt,
  ogImage = images.ogImage,
  wide = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — ${site.subtitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImageUrl = new URL(ogImage, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href={images.favicon} />
    <link rel="apple-touch-icon" href={images.appleTouchIcon} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.title} />
    {publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />

    {/* KaTeX 样式，只在有公式时才真正生效，体积很小 */}
    <link rel="stylesheet" href="/katex/katex.min.css" />

    {/*
      主题初始化必须在首次绘制前同步执行，否则暗色用户会看到一帧白闪。
      逻辑：localStorage 里存过就用存的，没存过就跟随系统。
    */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {
          /* 隐私模式下 localStorage 会抛异常，忽略即可，回落到系统偏好 */
        }
      })();
    </script>
  </head>

  <body>
    <div class="layout">
      <a class="skip-link" href="#main">Skip to content</a>
      <div class="page">
        <Header />
      </div>
      <main id="main" class="page" data-wide={wide ? '' : undefined}>
        <slot />
      </main>
      <div class="page">
        <Footer />
      </div>
    </div>
  </body>
</html>
