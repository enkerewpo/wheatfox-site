---
import { site, images } from '@/config';
import { url } from '@/lib/url';
import Sidebar from '@/components/Sidebar.astro';
import Footer from '@/components/Footer.astro';
import Terminal from '@/components/Terminal.astro';
import LifeFavicon from '@/components/LifeFavicon.astro';

// 自托管字体，不走任何第三方 CDN。
// 必须在 tokens.css 之前 —— 那里的 --font-* 变量引用的就是这些 family 名。
// （这一行曾经漏掉过：@font-face 一条都没进构建产物，字体文件照样被下面的
//  preload 下载了，所以网络面板里全是 200，看着一切正常，实际每个平台都在
//  用系统字体。preload 只负责下载，不声明任何东西。）
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/prose.css';

interface Props {
  title?: string;
  description?: string;
  /** OG type，文章页传 'article' */
  ogType?: 'website' | 'article';
  /** 文章页传发布时间 */
  publishedAt?: Date;
  /** 覆盖默认 OG 图 */
  ogImage?: string;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  publishedAt,
  ogImage = images.ogImage,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.title}` : site.title;

const base = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, base).href;
const ogImageUrl = new URL(ogImage, base).href;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />


    {/*
      preload 最关键的两个字体：正文常规体和代码体。
      不 preload 的话浏览器要等 CSS 解析完才知道要下载它们，
      这个延迟就是翻页时字体闪一下的直接原因。
    */}
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href={url('/fonts/fira-sans-latin-400-normal.woff2')} />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href={url('/fonts/source-code-pro-latin-wght-normal.woff2')} />

    <link rel="icon" href={url(images.favicon)} />
    <link rel="apple-touch-icon" href={url(images.appleTouchIcon)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={url("/rss.xml")}
    />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.title} />
    {publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="stylesheet" href={url("/katex/katex.min.css")} />

    {/*
      主题初始化必须在首次绘制前同步执行，否则暗色用户会看到一帧白闪。
      存过就用存的，没存过就跟随系统。
    */}
    <script is:inline>
      // 首屏同步执行，避免暗色用户看到一帧白闪。
      // 规则和 Sidebar.astro 里一致：系统偏好优先，手动覆盖 1 小时后失效。
      (function () {
        var theme = null;
        try {
          var saved = localStorage.getItem('theme');
          var at = Number(localStorage.getItem('theme-set-at'));
          if ((saved === 'light' || saved === 'dark') && at && Date.now() - at < 3600000) {
            theme = saved;
          }
        } catch (e) {
          /* 隐私模式下 localStorage 会抛异常，忽略 */
        }
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body>
    <div class="layout">
      <a class="skip-link" href="#main">Skip to content</a>

      <div class="shell">
        <Sidebar />
        <main id="main">
          <slot />
        </main>
      </div>

      <div class="page-footer">
        <Footer />
      </div>
    </div>

    {/* 彩蛋：终端浮层（按 ` 唤出）+ favicon 里跑生命游戏 */}
    <Terminal />
    <LifeFavicon />
  </body>
</html>
