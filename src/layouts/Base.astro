---
import { site, images } from '../config';
import { getLangFromUrl, pick, HTML_LANG, LANGS, DEFAULT_LANG, stripLangPrefix, localizePath } from '../i18n';
import { useTranslations } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// 自托管字体，不走任何第三方 CDN
import '@fontsource/patrick-hand/400.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/prose.css';

interface Props {
  title?: string;
  description?: string;
  /** OG type，文章页传 'article' */
  ogType?: 'website' | 'article';
  /** 文章页传发布时间 */
  publishedAt?: Date;
  /** 覆盖默认 OG 图 */
  ogImage?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  description = pick(site.description, lang),
  ogType = 'website',
  publishedAt,
  ogImage = images.ogImage,
} = Astro.props;

const pageTitle = title
  ? `${title} — ${site.title}`
  : `${site.title} — ${pick(site.subtitle, lang)}`;

const base = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, base).href;
const ogImageUrl = new URL(ogImage, base).href;

/** 同一页面的其它语言版本，给 hreflang 用 */
const bare = stripLangPrefix(Astro.url.pathname);
const alternates = LANGS.map((l) => ({
  lang: l,
  href: new URL(localizePath(bare, l), base).href,
}));
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />

    {/* 告诉搜索引擎这两个 URL 是同一页的不同语言版本 */}
    {alternates.map((a) => (
      <link rel="alternate" hreflang={HTML_LANG[a.lang]} href={a.href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizePath(bare, DEFAULT_LANG), base).href}
    />

    <link rel="icon" href={images.favicon} />
    <link rel="apple-touch-icon" href={images.appleTouchIcon} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={localizePath('/rss.xml', lang)}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    {publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="stylesheet" href="/katex/katex.min.css" />

    {/*
      主题初始化必须在首次绘制前同步执行，否则暗色用户会看到一帧白闪。
      存过就用存的，没存过就跟随系统。
    */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {
          /* 隐私模式下 localStorage 会抛异常，忽略，回落到系统偏好 */
        }
      })();
    </script>
  </head>

  <body>
    <div class="layout">
      <a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>
      <div class="page">
        <Header />
      </div>
      <main id="main" class="page">
        <slot />
      </main>
      <div class="page">
        <Footer />
      </div>
    </div>
  </body>
</html>
